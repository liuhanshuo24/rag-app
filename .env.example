# ===== 大模型配置（可插拔，改这里即可切换） =====
# 可选 provider：deepseek / qwen / doubao / openai
LLM_PROVIDER=deepseek

# DeepSeek（默认）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的DeepSeek密钥
LLM_MODEL=deepseek-flash

# 切换示例 —— 通义千问（阿里百炼）：
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-你的阿里云DashScope密钥
# LLM_MODEL=qwen-plus

# 切换示例 —— 豆包（火山方舟，模型ID在方舟控制台创建）：
# LLM_PROVIDER=doubao
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的火山方舟API Key
# LLM_MODEL=ep-2024xxxx-xxxx

# 切换示例 —— OpenAI：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-你的OpenAI密钥
# LLM_MODEL=gpt-4o-mini

# ===== 生成参数 =====
LLM_TEMPERATURE=0.3

# ===== 嵌入 / 重排模型（首次运行自动下载） =====
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# 有 GPU 可改为 cuda 加速
DEVICE=cpu

# ===== 检索参数 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
RERANK_TOP_K=5
RRF_K=60

# ===== 会话记忆 =====
MEMORY_TURNS=4
MAX_HISTORY_CHARS=2000
